#!/bin/bash -eu
# SPDX-FileCopyrightText: 2026 Uwe Fechner
# SPDX-License-Identifier: MIT
#
# Cut a release: verify Project.toml and the top CHANGELOG.md entry agree on the
# version, sync CITATION.cff to it, push, and post the `@JuliaRegistrator
# register()` comment (with the changelog entry as release notes) to
# https://github.com/OpenSourceAWE/WinchControllers.jl/issues/4, which is what
# actually triggers registration in this repo (see that issue's history).
# TagBot is installed (.github/workflows/TagBot.yml), so the vX.Y.Z tag is
# created automatically once the resulting registry PR is merged - this
# script does not tag.
#
# Bumping Project.toml's version and writing the CHANGELOG.md entry are NOT
# done here - do that first, commit it, then run this script.
#
# Usage: bin/release [-y]
#   -y  skip the confirmation prompts (for non-interactive use)

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

REPO="OpenSourceAWE/WinchControllers.jl"
ISSUE=4
ASSUME_YES=0
[[ "${1:-}" == "-y" ]] && ASSUME_YES=1

confirm() {
    [[ $ASSUME_YES -eq 1 ]] && return 0
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

# --- preconditions ---------------------------------------------------------
branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$branch" != "main" ]]; then
    echo "Error: on branch '$branch', release from 'main'." >&2
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree not clean. Commit or stash first." >&2
    git status --short
    exit 1
fi

git fetch origin main --quiet
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
    echo "Error: 'main' and 'origin/main' have diverged. Pull/push first." >&2
    exit 1
fi

# --- version from Project.toml ---------------------------------------------
version=$(grep -m1 '^version' Project.toml | sed -E 's/version = "(.*)"/\1/')
if [[ -z "$version" ]]; then
    echo "Error: could not read version from Project.toml." >&2
    exit 1
fi
tag="v$version"

if git rev-parse "$tag" >/dev/null 2>&1; then
    echo "Error: tag $tag already exists - this version was already released." >&2
    exit 1
fi

# --- top CHANGELOG.md entry must match Project.toml's version --------------
# Line-number based, not "the header is line 1": robust even if this file
# ever grows a leading title line before the first "### " entry.
mapfile -t header_lines < <(grep -n '^### ' CHANGELOG.md | cut -d: -f1 | head -2)
if [[ ${#header_lines[@]} -eq 0 ]]; then
    echo "Error: no '### ' entry found in CHANGELOG.md." >&2
    exit 1
fi
first=${header_lines[0]}
second=${header_lines[1]:-$(($(wc -l < CHANGELOG.md) + 1))}
header=$(sed -n "${first}p" CHANGELOG.md)
if [[ ! "$header" =~ ^\#\#\#\ WinchControllers\ v${version//./\\.}(\ |$) ]]; then
    echo "Error: CHANGELOG.md's top entry ('$header') does not match" >&2
    echo "       Project.toml's version ($version). Write the changelog entry first." >&2
    exit 1
fi

# Body of the top entry: everything between the first and second "### "
# headers (or end of file if there is no second one).
notes=$(sed -n "$((first + 1)),$((second - 1))p" CHANGELOG.md)

echo "Releasing WinchControllers $tag"
echo "----------------------------------------"
echo "$header"
echo "$notes"
echo "----------------------------------------"

# --- sync CITATION.cff -------------------------------------------------------
release_date=$(echo "$header" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' || date +%F)
if [[ -f CITATION.cff ]]; then
    sed -i -E "s/^version: .*/version: \"$version\"/" CITATION.cff
    sed -i -E "s/^date-released: .*/date-released: \"$release_date\"/" CITATION.cff
    if [[ -n "$(git status --porcelain CITATION.cff)" ]]; then
        echo
        git diff CITATION.cff
        confirm "Commit and push this CITATION.cff update?" || {
            echo "Aborted." >&2
            git checkout -- CITATION.cff
            exit 1
        }
        git add CITATION.cff
        git commit -m "Update CITATION.cff for $tag"
        git push origin main
    fi
fi

# --- trigger registration ---------------------------------------------------
body=$(printf '@JuliaRegistrator register()\n\nRelease notes:\n\n%s\n%s\n' "$header" "$notes")
echo
echo "About to post this comment to $REPO#$ISSUE:"
echo "----------------------------------------"
echo "$body"
echo "----------------------------------------"
confirm "Post it? This triggers JuliaRegistrator." || {
    echo "Not posted. Run again, or post it by hand, when ready." >&2
    exit 1
}

gh issue comment "$ISSUE" --repo "$REPO" --body "$body"
echo
echo "Posted. Once JuliaRegistrator opens the registry PR and it is merged,"
echo "TagBot creates the $tag tag here automatically."
