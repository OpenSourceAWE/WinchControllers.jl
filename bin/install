#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

usage() {
    cat <<USAGE
Usage: bin/install [-y] [--update] [--version X.Y | +X.Y] [-h]

Install the tracked Manifest-v<major>.toml.default as Manifest-v<major>.toml,
then instantiate and precompile the project and its examples, test and docs
subprojects. Needs Julia 1.12 or newer. Nothing outside the repository is changed.

  -y, --yes         no prompt: use the julia on the PATH
  --update          Pkg.update the live manifest instead; the .default stays untouched
  --version X.Y     use juliaup's Julia X.Y for this run (also +X.Y)
  -h, --help        show this help
USAGE
}

yes=false
update=false
channel=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes) yes=true ;;
        --update) update=true ;;
        --version)
            [[ $# -ge 2 ]] || { echo "--version needs a value, e.g. --version 1.12"; exit 1; }
            channel="$2"; shift ;;
        +*) channel="${1#+}" ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
    shift
done

cd "$(dirname "$0")/.."

if $yes; then
    # Julia loses piped output when started with stdin closed.
    exec </dev/null
elif [[ -z "$channel" ]]; then
    echo "Which Julia version do you want to use?"
    echo "  1) Julia 1.12"
    echo "  2) Julia 1.13"
    echo "  Enter) the julia on the PATH"
    read -rp "Enter 1 or 2: " choice
    case "$choice" in
        1) channel=1.12 ;;
        2) channel=1.13 ;;
        "") ;;
        *) echo "Invalid choice: '$choice'."; exit 1 ;;
    esac
fi

julia_cmd=(julia)
if [[ -n "$channel" ]]; then
    if ! juliaup status 2>/dev/null | grep -q " $channel "; then
        echo "Julia $channel is not installed; install it with: juliaup add $channel"
        exit 1
    fi
    julia_cmd=(julia "+$channel")
fi

julia_major=$("${julia_cmd[@]}" --version | awk '{split($3, v, "."); print v[1] "." v[2]}')
manifest="Manifest-v${julia_major}.toml"
echo "Using Julia $julia_major"

if [[ ! -f "${manifest}.default" ]]; then
    echo "Error: ${manifest}.default not found; supported: $(ls Manifest-v*.toml.default | tr '\n' ' ')"
    exit 1
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager
rm -f Manifest.toml
if $update; then
    pkg_step="Pkg.update(workspace=true)"
else
    cp "${manifest}.default" "$manifest"
    echo "Copied ${manifest}.default to $manifest"
    pkg_step="Pkg.instantiate(workspace=true)"
fi

"${julia_cmd[@]}" --startup-file=no --project -e \
    "using Pkg; $pkg_step; Pkg.precompile(workspace=true)"

if [[ ! -f .JETLSConfig.toml ]]; then
    cp .JETLSConfig.toml.default .JETLSConfig.toml
fi

echo
printf "\033[1;32mInstallation complete!\033[0m\n"
echo "Launch Julia with: bin/run_julia"
